  "reference": "Ephesians 1:1-2",
  "title": "Literary Design of Ephesians 1:1-2",
  "caption": "<bp-cite>Ephesians 1:1-2</bp-cite>. Translation and Literary Design by Tim Mackie for BibleProject Classroom: Ephesians (2019).",
  "updatedAt": "2024-02-05T18:32:47.000Z",
  "usx": null,
  "html": "<div class=\"group\">\n  <div class=\"group\">\n    <sup>1</sup> <bp-mark variant=\"highlight-light\" color=\"black\">Paul</bp-mark>\n  </div>\n  <div class=\"group\" indent=\"2\">\n    <div class=\"group\">\n      an apostle of Messiah Jesus\n    </div>\n    <div class=\"group\">\n      through the will of God,\n    </div>\n  </div>\n  <div class=\"group\">\n    <bp-mark variant=\"highlight-light\" color=\"black\">to the holy ones</bp-mark>\n  </div>\n  <div class=\"group\" indent=\"5\">\n    <div class=\"group\">\n      <bp-mark variant=\"highlight-light\" color=\"black\">who</bp-mark> [are in Ephesus]\n    </div>\n    <div class=\"group\">\n      <bp-mark variant=\"highlight-light\" color=\"black\">also</bp-mark> are believing in Messiah Jesus,\n    </div>\n  </div>\n  <div class=\"group\">\n    <sup>2</sup> <bp-mark variant=\"highlight-light\" color=\"black\">grace to y’all and peace</bp-mark>\n  </div>\n  <div class=\"group\" indent=\"15\">\n    <div class=\"group\">\n      from God our Father\n    </div>\n    <div class=\"group\">\n      <bp-mark variant=\"highlight\" color=\"black\">and the Lord Jesus Messiah.</bp-mark>.\n    </div>\n  </div>\n</div>\n"
}